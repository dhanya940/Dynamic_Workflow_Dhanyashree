# Copy this file to .env and fill in your real values. Never commit .env itself.

# PostgreSQL connection — replace with your real values, all in one line
DATABASE_URL=postgresql://workflow_user:yourpassword@localhost:5432/workflow_db

# App settings
APP_NAME=Dynamic Workflow Automation System
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
